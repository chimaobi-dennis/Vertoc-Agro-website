# ---------------------------------------------------------------------------
# Backend environment. Copy to server/.env and fill in. NEVER commit this file.
# ---------------------------------------------------------------------------

# Supabase (hosted Postgres). Leave both blank to use the local SQLite file.
SUPABASE_URL=https://qeogredokbndssfrcjmo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret (required when NODE_ENV=production)
TURNSTILE_SECRET_KEY=

# Bearer token protecting the MCP write endpoint when exposed publicly
VERTOC_MCP_TOKEN=

# --- CORS ------------------------------------------------------------------
# The site and API share an origin and the MCP client calls server-to-server,
# so nothing cross-origin is allowed in production by default. Only set this
# if a separate frontend or tool genuinely needs browser access to the API.
# Comma-separated, e.g. https://admin.example.com,https://staging.example.com
# ALLOWED_ORIGINS=

# --- Admin panel ---------------------------------------------------------
# Public URL of the site, used to build the link in user-invite emails.
# e.g. https://vertoc-agromain.vercel.app  (no trailing slash)
ADMIN_URL=

# --- Email (Resend) --------------------------------------------------------
# Optional here: the key can also be saved under Admin → Settings → Email,
# where it is stored encrypted (that one takes precedence). Server only.
RESEND_API_KEY=
# Public origin for quote links and email buttons (falls back to ADMIN_URL).
SITE_URL=
# Signing secret of the Resend webhook (email.received). Optional here: can be
# saved under Admin → Settings → Email → Inbound instead.
RESEND_WEBHOOK_SECRET=
# Local testing only: log emails as sent without calling Resend. NEVER on Vercel.
# EMAIL_DRY_RUN=1
