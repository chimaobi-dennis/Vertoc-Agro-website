# ---------------------------------------------------------------------------
# Backend environment. Copy to server/.env and fill in. NEVER commit this file.
# ---------------------------------------------------------------------------

# Supabase (hosted Postgres). Leave both blank to use the local SQLite file.
SUPABASE_URL=https://qeogredokbndssfrcjmo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret (required when NODE_ENV=production)
TURNSTILE_SECRET_KEY=

# Bearer token protecting the MCP write endpoint when exposed publicly
VERTOC_MCP_TOKEN=

# --- CORS ------------------------------------------------------------------
# The site and API share an origin and the MCP client calls server-to-server,
# so nothing cross-origin is allowed in production by default. Only set this
# if a separate frontend or tool genuinely needs browser access to the API.
# Comma-separated, e.g. https://admin.example.com,https://staging.example.com
# ALLOWED_ORIGINS=
