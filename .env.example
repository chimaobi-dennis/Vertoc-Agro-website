# Cloudflare Turnstile — create a widget at
# https://dash.cloudflare.com → Turnstile → Add site
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...      # public, shipped to the browser
# Backend (server/.env or the process env). NEVER commit or expose this one:
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Never put the service_role key here — VITE_* vars are inlined into the browser bundle.

# Supabase — sign-in for the admin panel only (anon key is public by design)
VITE_SUPABASE_URL=https://qeogredokbndssfrcjmo.supabase.co
VITE_SUPABASE_ANON_KEY=
